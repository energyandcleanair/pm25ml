#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $(basename "$0") <version_number>" >&2
    echo "Error: Expected exactly one argument (version number)" >&2
    exit 1
fi

version_number=$1

bucket=crea-pm25ml-project-website-assets
project=vital-form-455413-p8

gcloud -p $project storage cp gcs://$bucket/$version_number/metadata.json gcs://$bucket/metadata.json
gcloud -p $project storage cp gcs://$bucket/$version_number/color-scale.json gcs://$bucket/color-scale.json
